# --- Server ---
PORT=4002
HOST=0.0.0.0
NODE_ENV=production
LOG_LEVEL=info
# Set to 1 (number of hops) or true when running behind a reverse proxy / ingress.
TRUST_PROXY=false
# Comma separated list of origins allowed to call the API cross-origin (empty = same-origin only).
CORS_ORIGINS=
# Bearer token required for write endpoints, approvals and the audit trail (min. 16 chars).
# Strongly recommended anywhere other than your own machine. Generate with: openssl rand -hex 32
OPERATOR_TOKEN=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# --- Agent safety ---
# dry-run (default) simulates commands on a copy of the environment; execute changes it.
AGENT_DEFAULT_MODE=dry-run
# false disables execute mode entirely.
AGENT_ALLOW_EXECUTE=true
# destructive (default): approval for kill/restart; all: approval for every command.
AGENT_APPROVAL_POLICY=destructive
AGENT_MAX_STEPS=12
AGENT_STEP_DELAY_MS=400
AGENT_PLANNER_TIMEOUT_MS=20000
AGENT_COMMAND_TIMEOUT_MS=5000
AGENT_APPROVAL_TIMEOUT_MS=120000
AGENT_RUN_TIMEOUT_MS=600000
# Optional JSON Lines file for a durable audit trail (directory must be writable).
AUDIT_LOG_FILE=

# --- Optional LLM planner (default: deterministic rule-based planner) ---
# none | openai-compatible (OpenAI, Ollama, vLLM, LM Studio, OpenRouter...)
LLM_PROVIDER=none
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=15000
